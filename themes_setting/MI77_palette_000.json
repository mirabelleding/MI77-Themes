{
    "workbench.colorCustomizations": {
        "editor.background": "#1a1a1a",
        "sideBar.background": "#1a1a1a",
        "activityBar.background": "#1a1a1a",
        "panel.background": "#1a1a1a",
        "terminal.background": "#1a1a1a",
        "titleBar.activeBackground": "#1a1a1a",
        "statusBar.background": "#1a1a1a",

        "editor.foreground": "#E6E6E6",
        "editorLineNumber.foreground": "#555B66",
        "editorLineNumber.activeForeground": "#C8A7F0",
        "editorCursor.foreground": "#E6E6E6",
        "editor.selectionBackground": "#343842",
        "editor.lineHighlightBackground": "#191C21"
    },

    "editor.semanticHighlighting.enabled": true,

    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "namespace": "#0acaa7",

            "class": "#ea9b69",
            "type": "#E5C07B",
            "typeParameter": "#E5C07B",

            "function": "#B49AE8",
            "member": "#B49AE8",
            "property": "#B49AE8",

            "parameter": "#C8A7F0",
            "selfParameter": "#C8A7F0",
            "clsParameter": "#C8A7F0",

            "variable": "#62dff8",

            "keyword": "#D8A0C4",
            "operator": "#D8A0C4",

            "string": "#45cf9f",
            "number": "#F0A6CA",

            "comment": {
                "foreground": "#777777",
                "italic": true
            },

            "*.decorator:python": "#73a6f2"
        }
    },

    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "name": "Comments",
                "scope": [
                    "comment",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "foreground": "#777777",
                    "fontStyle": "italic"
                }
            },
            {
                "name": "Strings",
                "scope": [
                    "string",
                    "string.quoted.single",
                    "string.quoted.double",
                    "string.quoted.docstring"
                ],
                "settings": {
                    "foreground": "#e8e1aa"
                }
            },
            {
                "name": "Keywords",
                "scope": [
                    "keyword",
                    "storage.type",
                    "storage.modifier"
                ],
                "settings": {
                    "foreground": "#D8A0C4"
                }
            },
            {
                "name": "Numbers",
                "scope": "constant.numeric",
                "settings": {
                    "foreground": "#cb90cce0"
                }
            },
            {
                "name": "Builtins",
                "scope": [
                    "support.function.builtin",
                    "support.type.python"
                ],
                "settings": {
                    "foreground": "#7FDBCA"
                }
            },
            {
                "name": "Decorator @",
                "scope": [
                    "punctuation.definition.decorator.python",
                    "meta.function.decorator.python punctuation.definition.decorator.python"
                ],
                "settings": {
                    "foreground": "#73a6f2"
                }
            }
        ]
    }
}
